{
  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git -C * push)",
      "PowerShell(git -C * push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(./env_files/**)",
      "Read(./apps/mobile/android/keystore.properties)",
      "Read(**/*.pem)",
      "Read(**/*.p8)",
      "Read(**/*.jks)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/writeloop_guard.py\" pre-edit",
            "timeout": 15,
            "statusMessage": "WriteLoop 마이그레이션·DDL 설정 검사"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/writeloop_guard.py\" stop",
            "timeout": 30,
            "statusMessage": "WriteLoop 스키마 마이그레이션 누락 검사"
          }
        ]
      }
    ]
  }
}
