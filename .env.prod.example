GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

APP_CORS_ALLOWED_ORIGINS=https://app.writeloop.kr
APP_FRONTEND_BASE_URL=https://app.writeloop.kr
NEXT_PUBLIC_API_BASE_URL=https://api.writeloop.kr
APP_AUTH_REMEMBER_ME_DAYS=30
# Leave blank by default. Set explicitly in your real production environment if needed.
APP_ADMIN_EMAILS=
NGINX_CONF_PATH=infra/nginx/prod.conf

# 운영 DB는 TLS로 접속한다(sslMode=REQUIRED). 암호화 없이 붙는 useSSL=false는 쓰지 않는다.
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_DB_HOST:3306/writeloop?sslMode=REQUIRED&connectionTimeZone=Asia/Seoul&forceConnectionTimeZoneToSession=true
SPRING_DATASOURCE_USERNAME=writeloop_user
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATA_REDIS_HOST=writeloop-redis
SPRING_DATA_REDIS_PORT=6379
APP_DRAFT_TTL_DAYS=7

SPRING_MAIL_HOST=smtp.naver.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=lwd33021@naver.com
SPRING_MAIL_PASSWORD=your-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_FROM=yourid@naver.com

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_AUTHORIZATION_URI=https://nid.naver.com/oauth2.0/authorize
NAVER_TOKEN_URI=https://nid.naver.com/oauth2.0/token
NAVER_USER_INFO_URI=https://openapi.naver.com/v1/nid/me
NAVER_REDIRECT_URI=https://api.writeloop.kr/api/auth/social/naver/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_USER_INFO_URI=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_REDIRECT_URI=https://api.writeloop.kr/api/auth/social/google/callback

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_AUTHORIZATION_URI=https://kauth.kakao.com/oauth/authorize
KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
KAKAO_REDIRECT_URI=https://api.writeloop.kr/api/auth/social/kakao/callback

# Sign in with Apple 토큰 해지(회원 탈퇴). Apple Developer > Keys에서 Sign in with Apple 키를 만든다.
# APPLE_PRIVATE_KEY는 .p8 파일 내용을 줄바꿈을 \n으로 바꿔 한 줄로 넣는다. 비어 있으면 해지를 건너뛴다.
APPLE_CLIENT_ID=kr.writeloop
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
