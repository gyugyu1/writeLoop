# Android emulator (through local nginx on port 80)
EXPO_PUBLIC_API_BASE_URL_ANDROID=http://10.0.2.2

# iOS simulator on macOS
# EXPO_PUBLIC_API_BASE_URL_IOS=http://localhost

# Physical iPhone on the same Wi-Fi
# Replace the host with your PC's LAN IP, for example http://192.168.35.20
# EXPO_PUBLIC_API_BASE_URL_IOS=http://192.168.35.20
