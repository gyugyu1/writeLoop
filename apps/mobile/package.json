{
  "name": "@writeloop/mobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel --clear",
    "start:localhost": "expo start --dev-client --localhost --clear",
    "start:android-studio": "node scripts/start-with-api-env.js local-nginx",
    "start:android-studio:backend": "node scripts/start-with-api-env.js local",
    "start:android-studio:nginx": "node scripts/start-with-api-env.js local-nginx",
    "start:android-device:nginx": "node scripts/start-with-api-env.js device-nginx",
    "start:android-studio:prod": "node scripts/start-with-api-env.js prod",
    "android": "expo run:android",
    "android:emulator": "expo start --android --localhost --clear",
    "ios": "expo run:ios",
    "eas:configure": "npx eas-cli build:configure",
    "eas:build:ios": "npx eas-cli build --platform ios --profile production",
    "eas:submit:ios": "npx eas-cli submit --platform ios --profile production",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.17",
    "expo-apple-authentication": "~55.0.13",
    "expo-constants": "~55.0.15",
    "expo-crypto": "~55.0.14",
    "expo-device": "~55.0.15",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.10",
    "expo-image": "~55.0.9",
    "expo-linking": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-web-browser": "~55.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.2",
    "eslint-config-expo": "~55.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
